SPRING_DATASOURCE_USERNAME=

SPRING_DATASOURCE_PASSWORD=

SPRING_DATASOURCE_URL=

SPRING_DATASOURCE_DRIVER_CLASS_NAME=

SPRING_JPA_HIBERNATE_DDL_AUTO=

SPRING_JPA_PROPERTIES_HIBERNATE_DATABASE_PLATFORM=

RESEND_API_KEY=

RESEND_FROM_EMAIL=

RESEND_FROM_NAME=

# Case-file storage. Leave these commented to keep in-memory storage (files are lost on restart).
# Setting the bucket switches to S3; credentials come from the AWS default chain.
# Local S3: `docker compose up -d localstack`, then uncomment:
# CROWDTRACE_STORAGE_S3_BUCKET=crowdtrace-case-files
# CROWDTRACE_STORAGE_S3_REGION=us-east-1
# CROWDTRACE_STORAGE_S3_ENDPOINT=http://localhost:4566
# CROWDTRACE_STORAGE_S3_PATH_STYLE_ACCESS=true
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# Production: set BUCKET and REGION only, and grant the runtime role s3:PutObject/GetObject/DeleteObject.
